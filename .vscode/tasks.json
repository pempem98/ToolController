{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            },
            "env": {
                "PATH": "${env:LOCALAPPDATA}\\Programs\\Python\\Python313\\Scripts;${env:LOCALAPPDATA}\\Programs\\Python\\Python313;${env:LOCALAPPDATA}\\Microsoft\\WinGet\\Packages\\BrechtSanders.WinLibs.POSIX.UCRT_Microsoft.Winget.Source_8wekyb3d8bbwe\\mingw64\\bin;${env:LOCALAPPDATA}\\stm32cube\\bundles\\programmer\\2.23.0\\bin;${env:LOCALAPPDATA}\\stm32cube\\bundles\\stlink-gdbserver\\7.14.0+st.2\\bin;${env:LOCALAPPDATA}\\stm32cube\\bundles\\gnu-tools-for-stm32\\14.3.1+st.2\\bin;${env:LOCALAPPDATA}\\stm32cube\\bundles\\cmake\\4.3.1+st.1\\bin;${env:LOCALAPPDATA}\\stm32cube\\bundles\\ninja\\1.13.2+st.1\\bin;${env:PATH}"
            }
        }
    },
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "cmake --fresh --preset stm32h7 && cmake --build --preset stm32h7",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Flash Firmware to Board (ST-LINK)",
            "type": "shell",
            "command": "STM32_Programmer_CLI -c port=SWD -w build/app/tool_controller_stm32h7a3ziq.hex -v -rst",
            "dependsOn": "Build Firmware",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": []
        },
        {
            "label": "Rebuild Firmware (Clean & Build)",
            "type": "shell",
            "command": "cmake --fresh --preset stm32h7 && cmake --build --preset stm32h7 --clean-first",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": "cmake --fresh --preset host-tests && cmake --build --preset host-tests && ctest --preset host-tests",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Unit Tests with Coverage",
            "type": "shell",
            "command": "cmake --fresh --preset coverage && cmake --build --preset coverage && ctest --preset coverage && cmake --build --preset coverage --target coverage_report",
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Clean All (Firmware & Tests)",
            "type": "shell",
            "command": "cmake -E rm -rf build",
            "group": "build",
            "problemMatcher": []
        }
    ]
}