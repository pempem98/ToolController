{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32H7A3ZI (ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/app/tool_controller_stm32h7a3ziq.elf",
            "device": "STM32H7A3ZI",
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/platform/stm32h7a3ziq/stm32h7a3ziq.svd",
            "showDevDebugOutput": "none"
        }
    ]
}