{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32H7A3ZIT6Q (ST-Link Local Build)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/app/surgical_instrument_controller_stm32h7a3zit6q.elf",
            "device": "STM32H7A3ZIT6Q",
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/platform/stm32h7a3zit6q/stm32h7a3zit6q.svd",
            "serverpath": "${env:LOCALAPPDATA}/stm32cube/bundles/stlink-gdbserver/7.14.0+st.2/bin/ST-LINK_gdbserver.exe",
            "armToolchainPath": "${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin",
            "stm32cubeprogrammer": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin",
            "showDevDebugOutput": "none"
        },
        {
            "name": "Debug STM32H7A3ZIT6Q (CI / Docker ELF Downloaded)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/app/surgical_instrument_controller_stm32h7a3zit6q.elf",
            "device": "STM32H7A3ZIT6Q",
            "interface": "swd",
            "runToEntryPoint": "main",
            "svdFile": "${workspaceFolder}/platform/stm32h7a3zit6q/stm32h7a3zit6q.svd",
            "serverpath": "${env:LOCALAPPDATA}/stm32cube/bundles/stlink-gdbserver/7.14.0+st.2/bin/ST-LINK_gdbserver.exe",
            "armToolchainPath": "${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin",
            "stm32cubeprogrammer": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin",
            "showDevDebugOutput": "none",
            "sourceFileMap": {
                "/home/runner/work": "${workspaceFolder}/..",
                "/workspace/surgical-instrument-controller": "${workspaceFolder}",
                "/workspace": "${workspaceFolder}"
            }
        }
    ]
}