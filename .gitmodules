[submodule "interfaces"]
	path = interfaces
	url = git@github.com:your-company/core-embedded-interfaces.git
[submodule "services/motion_service"]
	path = services/motion_service
	url = git@github.com:your-company/svc-motion-control.git
[submodule "services/health_monitor"]
	path = services/health_monitor
	url = git@github.com:your-company/svc-health-monitor.git
[submodule "services/fieldbus_service"]
	path = services/fieldbus_service
	url = git@github.com:your-company/svc-fieldbus-router.git
[submodule "services/io_service"]
	path = services/io_service
	url = git@github.com:your-company/svc-io-controller.git
[submodule "middleware/freertos"]
	path = middleware/freertos
	url = https://github.com/FreeRTOS/FreeRTOS-Kernel.git
	branch = V10.6.0
[submodule "middleware/canopen_stack"]
	path = middleware/canopen_stack
	url = https://github.com/CANopenNode/CANopenNode.git
[submodule "middleware/ethercat_stack"]
	path = middleware/ethercat_stack
	url = https://github.com/OpenEtherCATsociety/SOES.git
